NODE_ENV=production
PORT=4310
HOST=127.0.0.1
DATABASE_FILE=./data/watchlist.sqlite
CACHE_TTL_HOURS=24
REQUEST_TIMEOUT_MS=12000
NEXT_AIRING_REFRESH_TTL_MS=900000
TRUST_PROXY=loopback
WATCHLIST_PASSWORD=
