[Unit]
Description=Watchlist
After=network.target

[Service]
Type=simple
User=watchlist
Group=watchlist
WorkingDirectory=/opt/watchlist
Environment=NODE_ENV=production
EnvironmentFile=/etc/watchlist.env
ExecStart=/usr/bin/node /opt/watchlist/backend/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
